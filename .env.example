# Copiar a .env y ajustar segun el hardware donde corre el servidor.
# docker-compose.yml usa estos valores; si una variable no esta definida,
# se usa el default indicado entre parentesis en cada linea.

# Host de Ollama visto desde dentro del contenedor Docker.
# Windows/Mac con Docker Desktop: http://host.docker.internal:11434 (default)
# Linux / Raspberry Pi con Docker Engine "clasico": probar con la IP del
# gateway del bridge de Docker (normalmente 172.17.0.1), por ejemplo:
# OLLAMA_HOST=http://172.17.0.1:11434
OLLAMA_HOST=http://host.docker.internal:11434

# Modelo LLM a usar. Debe descargarse antes con: ollama pull <modelo>
# Debe coincidir con lo que use start.sh/start_demo.bat al hacer "ollama pull".
#
# PC con GPU dedicada (ej. RTX 3060, 8GB+ VRAM):
#   MODEL_NAME=llama3.1:8b
# Raspberry Pi 5 (8GB RAM) u otro hardware limitado (default, recomendado):
#   MODEL_NAME=llama3.2:3b-instruct-q4_K_M
MODEL_NAME=llama3.2:3b-instruct-q4_K_M

# Ventana de contexto del modelo. Bajar en hardware con poca RAM.
OLLAMA_NUM_CTX=2048

# Cuanto tiempo mantiene Ollama el modelo cargado en memoria entre consultas.
OLLAMA_KEEP_ALIVE=30m

# Generaciones simultaneas permitidas. En Raspberry Pi dejar en 1: Ollama no
# gana nada corriendo mas de una generacion a la vez en ese hardware, y evita
# que las respuestas se degraden todas al mismo tiempo.
MAX_CONCURRENT_GENERATIONS=1

# Umbral minimo de confianza de enrutamiento (0-1) para no responder consultas
# claramente fuera de los dominios soportados. Calibrar con consultas reales
# (ver DOCUMENTACION.md).
MIN_ROUTING_CONFIDENCE=0.28

# Score minimo de similitud (0-1) para que un fragmento de la base de
# conocimiento se considere relevante.
MIN_CHUNK_SCORE=0.20

# Mensajes de historial de conversacion reenviados al LLM como contexto.
MAX_HISTORY_MESSAGES=8

# Origenes permitidos por CORS para /query, /health, etc. Separar con comas
# si hay mas de uno (ej. al acceder por la IP de la Pi ademas de localhost).
ALLOWED_ORIGINS=http://localhost:3000
